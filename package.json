{
  "name": "form-archiver",
  "version": "0.1.0",
  "description": "현재 웹페이지의 화면 내용과 작성 중인 입력값을 마크다운 기록으로 남기는 크롬 확장 프로그램",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome check --write .",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
